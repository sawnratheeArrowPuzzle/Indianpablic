rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitives
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'sawn6849@gmail.com';
    }

    // Validation helpers
    function isValidUserCreate(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'status', 'referralCode', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'phone', 'role', 'status', 'referralCode', 'referredByUid', 'referredByCode', 'upiId', 'unlockedPackageIds', 'createdAt', 'updatedAt']) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.role == 'member' &&
        data.status == 'active' &&
        data.referralCode is string && data.referralCode.size() >= 4 && data.referralCode.size() <= 32 &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidUserUpdate(data) {
      return data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'phone', 'role', 'status', 'referralCode', 'referredByUid', 'referredByCode', 'upiId', 'unlockedPackageIds', 'createdAt', 'updatedAt']) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 32)) &&
        (!('upiId' in data) || (data.upiId is string && data.upiId.size() <= 120)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000));
    }

    function isValidOrderCreate(data) {
      return data.keys().hasAll(['id', 'userId', 'packageId', 'amount', 'status', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'userEmail', 'packageId', 'packageName', 'amount', 'sponsorUid', 'referralCode', 'status', 'createdAt', 'updatedAt']) &&
        data.userId == request.auth.uid &&
        data.packageId is string && data.packageId.size() <= 64 &&
        data.amount is number && data.amount > 0 &&
        data.status == 'awaiting_payment' &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidPaymentCreate(data) {
      return data.keys().hasAll(['id', 'orderId', 'userId', 'amount', 'utr', 'status', 'createdAt']) &&
        data.keys().hasOnly(['id', 'orderId', 'userId', 'packageId', 'amount', 'utr', 'screenshotUrl', 'upiIdPaidTo', 'status', 'adminNote', 'verifiedBy', 'verifiedAt', 'createdAt']) &&
        data.userId == request.auth.uid &&
        data.orderId is string && data.orderId.size() <= 64 &&
        data.amount is number && data.amount > 0 &&
        data.utr is string && data.utr.size() >= 8 && data.utr.size() <= 40 &&
        data.status == 'pending' &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidWithdrawalCreate(data) {
      return data.keys().hasAll(['id', 'userId', 'amount', 'upiId', 'status', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'amount', 'upiId', 'status', 'payoutReference', 'adminNote', 'createdAt']) &&
        data.userId == request.auth.uid &&
        data.amount is number && data.amount > 0 &&
        data.upiId is string && data.upiId.size() >= 3 && data.upiId.size() <= 120 &&
        data.status == 'pending' &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidTicketCreate(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'subject', 'message', 'status', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'name', 'email', 'subject', 'message', 'status', 'adminReply', 'createdAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 160 &&
        data.message is string && data.message.size() >= 5 && data.message.size() <= 2000 &&
        data.status == 'open' &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    // 1. Admins allowlist
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isAdmin() || (isSignedIn() && request.auth.uid == adminUid));
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(adminUid);
    }

    // 2. Users (PII isolated to owner & admin; financial/role fields protected)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isAdmin() || (isSignedIn() && request.auth.uid == userId));
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isValidId(userId) && isSignedIn() && (
        (isAdmin() && incoming().uid == userId && incoming().keys().hasAll(['uid', 'email', 'displayName', 'role', 'status', 'referralCode', 'createdAt'])) ||
        isValidUserCreate(incoming(), userId)
      );
      allow update: if isValidId(userId) && (
        isAdmin() ||
        (
          isSignedIn() &&
          request.auth.uid == userId &&
          isValidUserUpdate(incoming()) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'upiId', 'photoURL', 'updatedAt']) &&
          incoming().role == existing().role &&
          incoming().status == existing().status &&
          incoming().referralCode == existing().referralCode
        )
      );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // 3. Public Catalog: Packages, Courses, PackageCourses, Website/UPI Public Settings
    match /packages/{packageId} {
      allow get: if isValidId(packageId);
      allow list: if true;
      allow create, update, delete: if isAdmin() && isValidId(packageId);
    }

    match /courses/{courseId} {
      allow get: if isValidId(courseId);
      allow list: if true;
      allow create, update, delete: if isAdmin() && isValidId(courseId);
    }

    match /packageCourses/{mappingId} {
      allow get: if isValidId(mappingId);
      allow list: if true;
      allow create, update, delete: if isAdmin() && isValidId(mappingId);
    }

    match /adminSettings/{settingId} {
      allow get: if isValidId(settingId) && (settingId == 'public' || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(settingId);
    }

    // 4. Orders (Owner create/read only; admin manages status transitions)
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(orderId) && isSignedIn() && isValidOrderCreate(incoming());
      allow update, delete: if isAdmin() && isValidId(orderId);
    }

    // 5. Payments (Owner submits pending proof; admin verifies/approves/rejects)
    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(paymentId) && isSignedIn() && isValidPaymentCreate(incoming());
      allow update, delete: if isAdmin() && isValidId(paymentId);
    }

    // 6. Referrals (Read by sponsor/admin; immutable once created by server/admin)
    match /referrals/{referralId} {
      allow get: if isValidId(referralId) && (isAdmin() || (isSignedIn() && (resource.data.sponsorUid == request.auth.uid || resource.data.referredUid == request.auth.uid)));
      allow list: if isAdmin() || (isSignedIn() && resource.data.sponsorUid == request.auth.uid);
      allow create, update, delete: if isAdmin() && isValidId(referralId);
    }

    // 7. Financial Ledgers (STRICTLY Admin/Server controlled; zero client writes)
    match /commissionLedger/{entryId} {
      allow get: if isValidId(entryId) && (isAdmin() || (isSignedIn() && resource.data.beneficiaryUid == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.beneficiaryUid == request.auth.uid);
      allow create, update, delete: if isAdmin() && isValidId(entryId);
    }

    match /walletLedger/{entryId} {
      allow get: if isValidId(entryId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin() && isValidId(entryId);
    }

    // 8. Withdrawals (Owner can request pending withdrawal; only admin approves/pays/rejects)
    match /withdrawals/{withdrawalId} {
      allow get: if isValidId(withdrawalId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(withdrawalId) && isSignedIn() && isValidWithdrawalCreate(incoming());
      allow update, delete: if isAdmin() && isValidId(withdrawalId);
    }

    // 9. Notifications
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isValidId(notificationId) && isSignedIn() && resource.data.userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow create, delete: if isAdmin() && isValidId(notificationId);
    }

    // 10. Support Tickets
    match /supportTickets/{ticketId} {
      allow get: if isValidId(ticketId) && (isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(ticketId) && isSignedIn() && isValidTicketCreate(incoming()) && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin() && isValidId(ticketId);
    }

    // 11. Immutable Audit Logs
    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && isValidId(logId);
      allow update, delete: if false;
    }
  }
}
