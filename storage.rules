rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthorizedAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'sawn6849@gmail.com';
    }

    match /package-covers/{fileName} {
      allow get: if true;
      allow list: if isAuthorizedAdmin();
      allow create, update: if isAuthorizedAdmin()
        && request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAuthorizedAdmin();
    }

    match /profile-pictures/{userId}/{fileName} {
      allow get: if true;
      allow list: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
